---
const pills = [
  { text: '✏️  Proefles',             color: 'bg-blue-100   text-blue-700   border-blue-200'   },
  { text: '👤  1-op-1',               color: 'bg-amber-100  text-amber-700  border-amber-200'  },
  { text: '🎯  Resultaatgericht',      color: 'bg-violet-100 text-violet-700 border-violet-200' },
  { text: '🎓  Gratis proefles',       color: 'bg-emerald-100 text-emerald-700 border-emerald-200' },
  { text: '📱  Telefonisch bereikbaar', color: 'bg-rose-100   text-rose-700   border-rose-200'   },
];
---

<section
  id="home"
  class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-br from-blue-50 via-slate-50 to-violet-50 pt-28 pb-20"
>

  <!-- Gradient mesh blobs -->
  <div class="absolute -top-24 -left-40 w-[650px] h-[650px] bg-blue-300/25 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-40 w-[550px] h-[550px] bg-violet-300/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] bg-amber-200/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-4xl mx-auto text-center">

      <!-- Floating pill badges -->
      <div class="flex flex-wrap justify-center gap-2.5 mb-10">
        {pills.map(pill => (
          <span
            class={`inline-flex items-center gap-1.5 ${pill.color} text-xs font-semibold px-4 py-2 rounded-full border shadow-sm hover:scale-105 transition-transform duration-200 cursor-default`}
          >
            {pill.text}
          </span>
        ))}
      </div>

      <!-- Oversized headline -->
      <h1 class="font-extrabold leading-[1.05] tracking-tight mb-6">
        <span class="block text-6xl sm:text-7xl lg:text-8xl bg-gradient-to-r from-blue-600 via-blue-500 to-violet-500 bg-clip-text text-transparent">
          Jouw
        </span>
        <span class="block text-6xl sm:text-7xl lg:text-8xl text-slate-800">
          Bijlesje
        </span>
      </h1>

      <!-- Sub-headline -->
      <p class="text-xl sm:text-2xl text-slate-500 font-medium mb-14 max-w-xl mx-auto leading-relaxed">
        Together All the Way to&nbsp;<span class="text-amber-500 font-bold">Success</span>
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="#contact"
          class="inline-flex items-center justify-center gap-2 bg-blue-600 text-white font-bold px-9 py-4 rounded-2xl text-base shadow-lg shadow-blue-200 hover:bg-blue-700 hover:shadow-xl hover:shadow-blue-300 hover:-translate-y-1 transition-all duration-300"
        >
          Neem Contact Op
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>
        <a
          href="#over"
          class="inline-flex items-center justify-center gap-2 bg-white/80 backdrop-blur-sm text-slate-700 font-semibold px-9 py-4 rounded-2xl text-base border border-slate-200 shadow-sm hover:bg-white hover:shadow-md hover:-translate-y-1 transition-all duration-300"
        >
          Hoe het werkt
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-slate-400/60 animate-bounce pointer-events-none">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>

</section>

