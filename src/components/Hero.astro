---
---

<section id="home" class="relative min-h-screen flex items-center bg-gradient-to-br from-blue-600 via-blue-700 to-slate-800 overflow-hidden">

  <!-- Decorative background circles -->
  <div class="absolute -top-32 -right-32 w-[500px] h-[500px] bg-white/5 rounded-full pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-white/5 rounded-full pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-white/[0.02] rounded-full pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-32 w-full">
    <div class="max-w-3xl mx-auto text-center">

      <!-- Badge -->
      <span class="inline-flex items-center gap-2 bg-white/15 text-white text-sm font-semibold px-4 py-2 rounded-full mb-8 backdrop-blur-sm border border-white/20">
        <span class="w-2 h-2 bg-green-400 rounded-full inline-block"></span>
        Professionele &amp; Persoonlijke Bijles
      </span>

      <!-- Headline -->
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold text-white leading-tight tracking-tight mb-5">
        Jouw Bijlesje
      </h1>

      <!-- Sub-headline -->
      <p class="text-xl sm:text-2xl text-blue-100 font-light mb-12 max-w-xl mx-auto leading-relaxed">
        Together All the Way to&nbsp;Success
      </p>

      <!-- CTA -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="#contact"
          class="inline-block bg-white text-blue-600 font-bold px-8 py-4 rounded-full text-base shadow-lg hover:bg-blue-50 hover:shadow-xl transition-all duration-200 hover:-translate-y-0.5"
        >
          Neem Contact Op
        </a>
        <a
          href="#over"
          class="inline-block bg-transparent text-white font-semibold px-8 py-4 rounded-full text-base border-2 border-white/40 hover:border-white hover:bg-white/10 transition-all duration-200"
        >
          Hoe het werkt
        </a>
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/50 animate-bounce pointer-events-none">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>

</section>
