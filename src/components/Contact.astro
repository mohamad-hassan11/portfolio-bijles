---

<section id="contact" class="py-24 bg-slate-50 dark:bg-slate-950">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-800 dark:text-slate-100 mt-2 mb-4">Contact</h2>
      <p class="text-slate-500 dark:text-slate-400 text-lg">Bijles nodig?</p>
    </div>

    <div class="max-w-xl mx-auto">

      <!-- Contact info -->
      <div>
        <h3 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-4">Neem contact op</h3>
        <p class="text-slate-500 dark:text-slate-400 leading-relaxed mb-8">
          Neem dan nu contact met ons op door een mail te sturen naar{' '}
          <a
            href="mailto:info@jouwbijlesje.nl"
            class="text-blue-600 dark:text-blue-400 font-semibold hover:underline"
          >
            info@jouwbijlesje.nl
          </a>. We nemen op dezelfde dag contact met u op.
        </p>

        <!-- Info cards -->
        <div class="space-y-4">
          <div class="flex items-center gap-4 bg-white dark:bg-slate-900 rounded-xl p-4 shadow-sm border border-slate-100 dark:border-slate-800">
            <div class="w-11 h-11 bg-blue-100 dark:bg-blue-950 rounded-xl flex items-center justify-center text-blue-600 dark:text-blue-400 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-xs text-slate-400 dark:text-slate-400 font-semibold uppercase tracking-wide mb-0.5">E-mail</p>
              <a
                href="mailto:info@jouwbijlesje.nl"
                class="text-slate-700 dark:text-slate-200 font-semibold text-sm hover:text-blue-600 dark:hover:text-blue-300 transition-colors"
              >
                info@jouwbijlesje.nl
              </a>
            </div>
          </div>
        </div>
      </div>


    </div>
  </div>
</section>
