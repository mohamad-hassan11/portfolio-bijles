---
interface PricingTier {
  name: string;
  price: string | null;
}

const tiers: PricingTier[] = [
  { name: 'Middelbare school onderbouw', price: '€30,00' },
  { name: 'Havo 4 & VWO 4 & VWO 5', price: '€45,00' },
  { name: 'Examenjaar', price: '€60,00' },
  { name: 'HBO & UNI', price: '€75,00' },
  { name: 'Selectie Geneeskunde', price: null },
];
---

<section id="tarieven" class="py-24 bg-white dark:bg-slate-900">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-800 dark:text-slate-100 mt-2 mb-4">Tarieven</h2>
      <p class="text-slate-500 dark:text-slate-400 text-lg">Transparante en eerlijke prijzen voor kwalitatieve bijles.</p>
    </div>

    <!-- Pricing cards -->
    <div class="grid grid-cols-1 sm:grid-cols-4 lg:grid-cols-8 gap-6 items-center">
      {tiers.map((tier) => (
        <div
          class="sm:col-span-2 last:sm:col-span-4 last:sm:col-start-1 last:lg:col-start-3 rounded-2xl p-8 flex flex-col items-center text-center border transition-all duration-200 bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md hover:border-blue-100 dark:hover:border-blue-800"
        >
          <!-- Name -->
          <h3
            class="text-base font-bold mb-6 leading-snug text-slate-700 dark:text-slate-200"
          >
            {tier.name}
          </h3>

          <!-- Price or CTA -->
          {tier.price ? (
            <div class="mt-auto">
              <span
                class="text-4xl font-extrabold text-blue-600 dark:text-blue-400"
              >
                {tier.price}
              </span>
              <span
                class="block text-sm mt-1.5 text-slate-400 dark:text-slate-400"
              >
                per les *
              </span>
            </div>
          ) : (
            <div class="mt-auto w-full">
              <a
                href="#contact"
                class="inline-block w-full bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 font-bold px-6 py-3 rounded-xl text-4xl hover:bg-blue-50 dark:hover:bg-blue-950 transition-colors shadow-md"
              >
                Neem Contact met ons op!
              </a>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Disclaimer -->
    <p class="text-center text-slate-400 dark:text-slate-400 text-xl mt-10">* Een les is 60 min.</p>

  </div>
</section>
