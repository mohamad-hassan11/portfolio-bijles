---
const navLinks = [
  { label: 'Home', href: '#home' },
  { label: 'Over jouw bijlesje', href: '#over' },
  { label: 'Tarieven', href: '#tarieven' },
];
---

<!-- Floating glassmorphic navbar -->
<header class="fixed top-4 left-1/2 -translate-x-1/2 z-50 w-[calc(100%-2rem)] max-w-5xl">

  <!-- Main bar -->
  <div class="bg-white/70 dark:bg-slate-900/90 backdrop-blur-md border border-white/80 dark:border-slate-700 rounded-2xl shadow-lg shadow-slate-200/60 dark:shadow-black/20 px-5 py-3">
    <div class="flex items-center justify-between">

      <!-- Logo -->
      <a
        href="#home"
        class="text-lg font-extrabold bg-gradient-to-r from-blue-600 dark:from-blue-400 to-violet-500 dark:to-violet-400 bg-clip-text text-transparent hover:opacity-80 transition-opacity tracking-tight select-none"
      >
        Jouw Bijlesje
      </a>

      <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-xl text-slate-600 hover:bg-blue-50 dark:text-slate-300 dark:hover:bg-blue-950 transition-colors"
        aria-label="Donkere modus"
        aria-pressed="false"
        title="Donkere modus"
      >
        <svg class="theme-moon h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.9 13a9 9 0 0 1-9.9-9.9A9 9 0 1 0 20.9 13Z" /></svg>
        <svg class="theme-sun h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
      </button>
      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-300 hover:bg-blue-50 dark:hover:bg-blue-950 font-medium transition-all duration-200 text-sm px-4 py-2 rounded-xl"
          >
            {link.label}
          </a>
        ))}
        <a
          href="#contact"
          class="ml-3 bg-blue-600 text-white font-semibold px-5 py-2 rounded-xl text-sm shadow-md shadow-blue-200 dark:shadow-black/20 hover:bg-blue-700 hover:shadow-blue-300 dark:hover:shadow-black/30 hover:-translate-y-0.5 transition-all duration-200"
        >
          Contact
        </a>
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-xl text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-300 hover:bg-blue-50 dark:hover:bg-blue-950 transition-colors"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      </div>
    </div>
  </div>

  <!-- Mobile dropdown (same glass style) -->
  <div
    id="mobile-menu"
    class="hidden mt-2 bg-white/80 dark:bg-slate-900/90 backdrop-blur-md border border-white/80 dark:border-slate-700 rounded-2xl shadow-lg shadow-slate-200/60 dark:shadow-black/20 px-4 py-3"
  >
    <nav class="flex flex-col gap-1">
      {[...navLinks, { label: 'Contact', href: '#contact' }].map(link => (
        <a
          href={link.href}
          class="mobile-nav-link block px-4 py-2.5 rounded-xl text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-300 hover:bg-blue-50 dark:hover:bg-blue-950 font-medium transition-colors text-sm"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>

</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  const preference = window.matchMedia('(prefers-color-scheme: dark)');
  let savedTheme: string | null = null;
  try { savedTheme = localStorage.getItem('jouwbijlesje-theme'); } catch {}
  let hasPreference = savedTheme === 'light' || savedTheme === 'dark';

  function applyTheme(theme: string) {
    document.documentElement.dataset.theme = theme;
    themeToggle?.setAttribute('aria-pressed', String(theme === 'dark'));
  }

  applyTheme(document.documentElement.dataset.theme || 'light');
  themeToggle?.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    hasPreference = true;
    applyTheme(theme);
    try { localStorage.setItem('jouwbijlesje-theme', theme); } catch {}
  });
  preference.addEventListener('change', (event) => {
    if (!hasPreference) applyTheme(event.matches ? 'dark' : 'light');
  });
  window.addEventListener('storage', (event) => {
    if (event.key !== 'jouwbijlesje-theme' && event.key !== null) return;
    hasPreference = event.newValue === 'light' || event.newValue === 'dark';
    applyTheme(hasPreference ? event.newValue! : preference.matches ? 'dark' : 'light');
  });

  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    menuIcon?.classList.toggle('hidden', !isOpen);
    closeIcon?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

